---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
const title = "Common Obligations — The future is a series of decisions.";
const description =
  "An interactive essay on AI power and accountability. Explore the choices, the tradeoffs, and six obligations for the people building our future.";
const socialImage = new URL("/assets/social-card.jpg", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><link rel="icon" href="/favicon.svg" /><meta
      name="theme-color"
      content="#eeeee8"
    /><title>
      Common Obligations — The future is a series of decisions.
    </title><meta
      name="description"
      content="An interactive essay on AI power and accountability. Explore the choices, the tradeoffs, and six obligations for the people building our future."
    /><link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    /><link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Common Obligations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The future is a series of decisions. Common Obligations, beside a monochrome city at night."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="The future is a series of decisions. Common Obligations."
    />
  </head>
  <body>
    <a href="#main" class="skip">Skip to essay</a>
    <div class="progress" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <noscript
      ><div class="no-script">
        Surveillance, release, and coordination controls require JavaScript.
        Defensive access, discovery, and incident comparisons work without it.
        The essay, obligations, and source notes remain available.
      </div></noscript
    >
    <script>
      import { initPage } from "../scripts/main.js";
      initPage();
    </script>
  </body>
</html>
