---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
const title = "Common Obligations — The future is a series of decisions.";
const description =
  "An interactive essay on AI power and accountability. Explore the choices, the tradeoffs, and six obligations for the people building our future.";
const socialImage = new URL(
  "/assets/abstract/social-crossing-v2.jpg",
  Astro.site,
).href;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><link rel="icon" href="/favicon.svg" /><meta
      name="theme-color"
      content="#f1eee5"
    /><title>
      Common Obligations — The future is a series of decisions.
    </title><meta
      name="description"
      content="An interactive essay on AI power and accountability. Explore the choices, the tradeoffs, and six obligations for the people building our future."
    /><link
      rel="preload"
      href="/fonts/instrument-serif-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    /><link
      rel="preload"
      href="/fonts/instrument-serif-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    /><link
      rel="preload"
      href="/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    /><link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    {
      Astro.url.pathname.startsWith("/prototype") && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta property="og:site_name" content="Common Obligations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The future is a series of decisions. Common Obligations, beside nested stone thresholds, distant islands and rust threads on ivory."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="The future is a series of decisions. Common Obligations."
    />
  </head>
  <body>
    <!-- THESIS: Six independent questions about power, not a predicted timeline.
    OWN-WORLD: Ivory paper, charcoal engraved fragments, rust vector threads; unboxed comparisons.
    STORY: Orient, examine conditions, inspect evidence, trace obligations.
    FIRST VIEWPORT: Oversized left headline, diagonal floating architecture on the right, landscape below; Explore six scenarios on clear paper.
    FORM: Crossing, user-delegated selection; seed 2a571022. Layered natural scroll with calm reading surfaces.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <a href="#main" class="skip">Skip to essay</a>
    <div class="progress" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <noscript
      ><div class="no-script">
        All comparisons, evidence and the essay remain available without
        JavaScript. Scroll-linked artwork and current-chapter tracking are
        optional enhancements.
      </div></noscript
    >
    <script>
      import { initPage } from "../scripts/main.js";
      initPage();
    </script>
  </body>
</html>
