---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/index.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><link rel="icon" href="/favicon.svg" /><meta
      name="theme-color"
      content="#eeeee8"
    /><title>
      Common Obligations — The future is a series of decisions.
    </title><meta
      name="description"
      content="An interactive essay on AI power and accountability. Explore the choices, the tradeoffs, and six obligations for the people building our future."
    /><link rel="preconnect" href="https://fonts.googleapis.com" /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    /><link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    /><link rel="canonical" href={Astro.site} /></head
  >
  <body>
    <a href="#main" class="skip">Skip to essay</a>
    <div class="progress" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <noscript
      ><div class="no-script">
        Interactive comparisons require JavaScript. The essay, obligations, and
        source notes remain available below.
      </div></noscript
    >
    <script>
      import { initPage } from "../scripts/main.js";
      initPage();
    </script>
  </body>
</html>
