---
const { id, legend, options } = Astro.props;
---

<fieldset class="policy-comparison">
  <legend>{legend}</legend>
  <div class="policy-controls">
    <label
      ><input type="radio" name={id} value="all" checked /> Compare all</label
    >
    {
      options.map((o, i) => (
        <label>
          <input type="radio" name={id} value={String(i)} />
          {o.name}
        </label>
      ))
    }
  </div>
  <div class="policy-options">
    {
      options.map((o, i) => (
        <section
          class="policy-option"
          data-policy-option={String(i)}
          aria-label={o.name}
        >
          <>
            <span class="section-label">{String(i + 1).padStart(2, "0")}</span>
            <h3>{o.name}</h3>
            <dl>
              <>
                <dt>The strongest case</dt>
                <dd>{o.benefit}</dd>
                <dt>What it asks us to accept</dt>
                <dd>{o.cost}</dd>
                <dt>Who feels the difference</dt>
                <dd>{o.people}</dd>
                <dt>Evidence to ask for</dt>
                <dd>{o.evidence}</dd>
              </>
            </dl>
          </>
        </section>
      ))
    }
  </div>
</fieldset>
