---
// The illustrative case that tests an obligation: its situation, each decision
// with every option side by side, and the documented accounts it draws on.
import Register from "./Register.astro";
import Option from "./Option.astro";
import { source, type Case } from "../lib/content";
interface Props {
  entry: Case;
}
const c = Astro.props.entry.data;
const framings = c.framings ?? [];
const label = (id: string) => framings.find((f) => f.id === id)?.label ?? id;
const accounts = await Promise.all(
  c.accounts.map(async (a) => ({
    ...a,
    src: await source(a.source),
    also: await Promise.all((a.also ?? []).map(source)),
  })),
);
---

<section class="case" id="case" aria-labelledby="case-title">
  <Register kind="illustrative" />
  <h2 id="case-title">The case that tests it</h2>
  <p class="question">{c.question}</p>
  <p class="situation measure">{c.situation}</p>
  {
    framings.length > 0 && (
      <ul class="framings">
        {framings.map((f) => (
          <li>
            <strong>{f.label}.</strong> {f.note}
          </li>
        ))}
      </ul>
    )
  }
  {
    c.decisions.map((d, i) => (
      <section
        class="decision"
        id={`decision-${d.id}`}
        aria-labelledby={`decision-${d.id}-title`}
      >
        <h3 id={`decision-${d.id}-title`}>
          {c.decisions.length > 1 && (
            <span class="mono n">{String(i + 1).padStart(2, "0")}</span>
          )}
          {d.prompt}
        </h3>
        {typeof d.context === "string" ? (
          <p class="context measure">{d.context}</p>
        ) : (
          <dl class="contexts">
            {Object.entries(d.context).map(([id, text]) => (
              <div>
                <dt class="mono">{label(id)}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="options" style={`--n:${d.options.length}`}>
          {d.options.map((o) => (
            <Option option={o} framings={framings} />
          ))}
        </div>
      </section>
    ))
  }
  {c.notes?.map((n) => <p class="note measure">{n}</p>)}
  <p class="inference measure">
    <span class="mono">Our inference</span>
    {c.inference}
  </p>
</section>

<section class="accounts" id="accounts" aria-labelledby="accounts-title">
  <Register kind="reported" />
  <h2 id="accounts-title">What the case draws on</h2>
  <div class="account-list">
    {
      accounts.map((a) => (
        <article class="account">
          <p class="mono kind">{a.label}</p>
          <h3>{a.title}</h3>
          {(a.occurred || a.disclosed) && (
            <dl class="mono when">
              {a.occurred && (
                <div>
                  <dt>Happened</dt>
                  <dd>{a.occurred}</dd>
                </div>
              )}
              {a.disclosed && (
                <div>
                  <dt>Reported</dt>
                  <dd>{a.disclosed}</dd>
                </div>
              )}
            </dl>
          )}
          {a.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          <p class="mono src">
            {[a.src, ...a.also].map((s, i) => (
              <>
                {i > 0 && <br />}
                <a href={s.data.url}>
                  {s.data.publisher}: {s.data.title}
                </a>
              </>
            ))}
          </p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .case,
  .accounts {
    padding-block: var(--space-8) 0;
  }
  h2 {
    margin-bottom: var(--space-4);
  }
  .question {
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }
  .situation,
  .context,
  .note {
    color: var(--ink);
  }
  .framings {
    list-style: none;
    padding: 0;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
    font-size: var(--step--1);
  }
  .framings strong {
    font-weight: 600;
  }
  .decision {
    margin-top: var(--space-7);
  }
  .decision h3 {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }
  .n {
    color: var(--accent);
  }
  .contexts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    max-width: 60rem;
  }
  .contexts dt {
    color: var(--muted);
    margin-bottom: var(--space-1);
  }
  .options {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .note {
    margin-top: var(--space-6);
    color: var(--muted);
  }
  .inference {
    margin-top: var(--space-6);
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
  }
  .inference .mono {
    display: block;
    color: var(--accent);
    margin-bottom: var(--space-1);
  }
  .account-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-6);
    margin-top: var(--space-5);
  }
  .account {
    border-top: var(--rule-strong);
    padding-top: var(--space-4);
  }
  .account h3 {
    font-size: var(--step-1);
    margin-block: var(--space-2) var(--space-3);
  }
  .account p + p {
    margin-top: var(--space-3);
  }
  .kind,
  .when dt {
    color: var(--muted);
  }
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-3);
  }
  .when div {
    display: flex;
    gap: var(--space-2);
  }
  .src {
    overflow-wrap: anywhere;
  }
  @media (max-width: 860px) {
    .options,
    .contexts {
      grid-template-columns: 1fr;
    }
    .options :global(.option) {
      grid-row: auto;
      grid-template-rows: none;
      margin-bottom: var(--space-5);
    }
  }
</style>
