---
// One policy option inside a case. The reasoning is a native disclosure.
import { OPTION_LABELS } from "../../lib/content";
interface Props {
  option: Record<string, unknown>;
  framings?: { id: string; label: string }[];
}
const { option: o, framings = [] } = Astro.props;
const fields = Object.keys(OPTION_LABELS).filter(
  (k) => o[k],
) as (keyof typeof OPTION_LABELS)[];
const framedLabel = (id: string) =>
  framings.find((f) => f.id === id)?.label ?? id;
const framed = (v: unknown) => Object.entries(v as Record<string, string>);
---

<section class="option" aria-label={o.name as string}>
  <h4>{o.name as string}</h4>
  {o.thesis ? <p class="thesis">{o.thesis as string}</p> : null}
  <p class="summary">{o.summary as string}</p>
  <p class="tradeoff">{o.tradeoff as string}</p>
  <details>
    <summary class="mono">Reasoning and limits</summary>
    <dl>
      {
        fields.map((k) => {
          const v = o[k];
          return typeof v === "string" ? (
            <div>
              <dt>{OPTION_LABELS[k]}</dt>
              <dd>{v}</dd>
            </div>
          ) : (
            <div>
              <dt>{OPTION_LABELS[k]}</dt>
              {framed(v).map(([id, text]) => (
                <dd>
                  <span class="mono framing">{framedLabel(id)}</span> {text}
                </dd>
              ))}
            </div>
          );
        })
      }
    </dl>
  </details>
</section>

<style>
  .option {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    align-content: start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--rule-strong);
  }
  h4 {
    font-size: var(--step-1);
  }
  .thesis {
    color: var(--muted);
  }
  .tradeoff {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  details > summary {
    padding-block: var(--space-2);
    color: var(--accent);
  }
  dl {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-3) var(--space-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  dt {
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  dd + dd {
    margin-top: var(--space-2);
  }
  .framing {
    display: block;
    color: var(--muted);
  }
</style>
