---
// A figure, or while it is not drawn yet, its obligation number in its place.
import Figure from "./Figure.astro";
interface Props {
  name: string;
  label: string;
  number?: number;
  parts?: { rest: string; items: string[] };
  size?: "small" | "large";
}
const { name, label, number, parts, size = "small" } = Astro.props;
const drawn = Object.keys(
  import.meta.glob("../../hairline/snapshots/*.svg"),
).some((p) => p.endsWith(`/${name}.svg`));
---

{
  drawn ? (
    <Figure name={name} label={label} parts={parts} size={size} />
  ) : (
    <div class:list={["pending", size]} role="img" aria-label={label}>
      <span class="mono">{String(number ?? "").padStart(2, "0")}</span>
    </div>
  )
}

<style>
  .pending {
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    border: 1px dashed var(--lo);
    color: var(--mid);
  }
  .pending span {
    font-size: var(--step-4);
  }
  .small {
    max-width: 22rem;
  }
  .large {
    max-width: 40rem;
  }
</style>
