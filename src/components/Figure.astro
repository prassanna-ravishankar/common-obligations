---
// A Hairline figure: the static rest pose (readable without JS) plus a read-out
// that names a real item from the argument. src/hairline/mount.ts hydrates it.
interface Props {
  name: string;
  label: string;
  parts?: { rest: string; items: string[] };
  size?: "small" | "large";
  transition?: boolean;
}
const { name, label, parts, size = "large", transition = true } = Astro.props;
const snapshots = import.meta.glob("../hairline/snapshots/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const svg = snapshots[`../hairline/snapshots/${name}.svg`]?.replace(
  /^<!--.*?-->\n/,
  "",
);
const rest = parts?.rest ?? "";
---

<div class:list={["figure", size]}>
  <div
    data-hairline={name}
    data-parts={parts?.items.join("|")}
    data-rest={rest}
    data-ambient
    role="img"
    aria-label={label}
    style={transition ? `view-transition-name: fig-${name}` : undefined}
  >
    {svg ? <Fragment set:html={svg} /> : null}
  </div>
  <p class="readout mono" aria-hidden="true" data-readout>{rest}</p>
</div>

<style>
  .figure {
    position: relative;
    min-width: 0;
  }
  .figure [data-hairline] {
    width: 100%;
  }
  .small {
    max-width: 22rem;
  }
  .large {
    max-width: 40rem;
  }
  /* As on the Hairline bench: the read-out sits in the corner, outside the drawing. */
  .readout {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--muted);
    pointer-events: none;
  }
</style>
