---
import { scenarios } from "../data/scenarios.js";
const groups = [
  { title: "Who may act?", ids: ["surveillance", "release"] },
  { title: "Who benefits?", ids: ["defense", "discovery"] },
  { title: "Who answers?", ids: ["incident", "race"] },
];
---

<section
  id="decisions"
  class="scenario-index"
  aria-labelledby="scenario-index-title"
>
  <h2 id="scenario-index-title">
    Where these questions<br /><em>become decisions.</em>
  </h2>
  <p>
    Six situations make parts of this larger question concrete: who may use a
    capability, whether its benefits reach people, and who answers when it
    causes harm. They do not settle how an economy should work. They show where
    its rules enter people’s lives.
  </p>
  <div class="scenario-groups">
    {
      groups.map((group) => (
        <div class="scenario-group">
          <>
            <h3>{group.title}</h3>
            <div class="scenario-index-grid">
              {group.ids.map((id) => {
                const s = scenarios.find((s) => s.id === id);
                return (
                  <a href={`#${s.id}`}>
                    <h4>
                      {s.number} / {s.title}
                    </h4>
                    <p>{s.question}</p>
                  </a>
                );
              })}
            </div>
          </>
        </div>
      ))
    }
  </div>
</section>
