---
import Argument from "../Argument.astro";
const { id, options } = Astro.props;
const kind = id.startsWith("coordination") ? "race" : id.split("-")[0];
---

<div
  class={`reading-sequence reading-sequence--${kind}`}
  data-reading-sequence={id}
  data-kind={kind}
  data-count={options.length}
>
  <div class="reading-stage">
    <a class="reading-bypass" href={`#${id}-all`} hidden
      >Skip to complete comparison</a
    >
    <div class="settled-reading" id={`${id}-all`} data-reading-all={id}>
      <div class="settled-columns" style={`--columns:${options.length}`}>
        {
          options.map((option, i) => (
            <section aria-label={option.name} data-focus={i}>
              <Argument option={option} />
            </section>
          ))
        }
      </div>
    </div>
  </div>
</div>
