---
import { timelineEvents, timelineReview } from "../../data/timeline.js";
import { obligationSummaries } from "../../data/obligations.js";

const date = (value) =>
  new Date(`${value}T12:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
const month = (value) =>
  new Date(`${value}-01T12:00:00Z`).toLocaleDateString("en-GB", {
    month: "short",
    timeZone: "UTC",
  });

// Oldest first: the axis and the columns both read left to right.
const events = [...timelineEvents].sort((a, b) => a.date.localeCompare(b.date));

// Two honest linear segments: January to August is compressed, September is
// widened so same-week events stay distinct. The break is drawn and captioned.
const DAY = 864e5;
const at = (iso) => Date.parse(`${iso}T00:00:00Z`);
const [start, september, end] = ["2026-01-01", "2026-09-01", "2026-10-01"].map(
  at,
);
const BREAK = 38;
const RESUME = 42;
const x = (ms) =>
  ms < september
    ? ((ms - start) / (september - start)) * BREAK
    : RESUME + ((ms - september) / (end - september)) * (100 - RESUME);
const day = (iso) => x(at(iso) + DAY / 2);
const nextMonth = (ym) => {
  const [y, m] = ym.split("-").map(Number);
  return m === 12 ? `${y + 1}-01` : `${y}-${String(m + 1).padStart(2, "0")}`;
};

// Geometry is in a 1000 × 180 box stretched to the axis width; strokes do not scale.
const BASE = 132;
const stack = {};
const marks = events.map((event) => {
  const position = day(event.date);
  const level = (stack[event.date] = (stack[event.date] ?? -1) + 1);
  const occurred = event.occurredOn && {
    from: x(at(`${event.occurredOn}-01`)),
    to: x(at(`${nextMonth(event.occurredOn)}-01`)),
    label: event.occurredLabel,
    month: month(event.occurredOn),
  };
  return { event, position, level, occurred };
});
const arcs = marks
  .filter((mark) => mark.occurred)
  .map(({ event, position, occurred }, i, all) => {
    const from = ((occurred.from + occurred.to) / 2) * 10;
    const to = position * 10;
    const lift = BASE - 112 + (all.length - 1 - i) * 30;
    return {
      id: event.id,
      d: `M${from} ${BASE}C${from} ${lift} ${to} ${lift} ${to} ${BASE}`,
    };
  });
const months = [
  "2026-01",
  "2026-02",
  "2026-03",
  "2026-04",
  "2026-05",
  "2026-06",
  "2026-07",
  "2026-08",
].map((ym) => ({ ym, left: x(at(`${ym}-01`)), label: month(ym) }));
// Adjacent day labels are dropped on narrow screens; the entries carry every date.
const days = [...new Set(events.map((event) => event.date))].map(
  (iso, i, all) => ({
    left: day(iso),
    label: String(Number(iso.slice(8))),
    near: i > 0 && at(iso) - at(all[i - 1]) < 3 * DAY,
  }),
);
const review = day(timelineReview);

const highlight = marks
  .map(
    ({ event }) =>
      `.timeline-record:has(#timeline-${event.id}:is(:hover,:focus-within)) [data-mark="${event.id}"]{--mark:1}`,
  )
  .join("");
const highlightStyle = `<style>@media (hover:hover){${highlight}}</style>`;
---

<section
  id="timeline"
  class="timeline"
  aria-labelledby="timeline-title"
  data-timeline
>
  <header class="timeline-heading">
    <h2 id="timeline-title">The argument meets <em>events.</em></h2>
    <p>
      Care delayed. Payment contested. Capabilities advancing. Read recent
      events beside the responsibilities this proposal asks for.
    </p>
    <p class="timeline-meta">
      September 2026. Sources checked <time datetime={timelineReview}
        >{date(timelineReview)}</time
      >. A selected record, updated by hand.
    </p>
    <div class="timeline-actions">
      <a href="#introduction">Continue to the argument</a>
      <button type="button" hidden data-motion-toggle aria-pressed="false"
        >Pause motion</button
      >
    </div>
  </header>
  <div class="timeline-record">
    <figure class="timeline-axis" aria-hidden="true" data-timeline-axis>
      <div class="axis-plot">
        <svg
          class="axis-layer axis-layer--line"
          viewBox="0 0 1000 180"
          preserveAspectRatio="none"
          fill="none"
        >
          <path
            class="axis-line"
            d={`M0 ${BASE}H${BREAK * 10 - 4}M${RESUME * 10 + 4} ${BASE}H${review * 10}`}
          ></path>
          <path class="axis-future" d={`M${review * 10} ${BASE}H1000`}></path>
          <path
            class="axis-break"
            d={`M${BREAK * 10 + 2} ${BASE + 8}l10 -16M${BREAK * 10 + 16} ${BASE + 8}l10 -16`}
          ></path>
        </svg>
        <svg
          class="axis-layer axis-layer--arcs"
          viewBox="0 0 1000 180"
          preserveAspectRatio="none"
          fill="none"
        >
          {
            arcs.map((arc) => (
              <path class="axis-arc" data-mark={arc.id} d={arc.d} />
            ))
          }
        </svg>
        {
          marks.map(({ event, position, level, occurred }) => (
            <>
              {occurred && (
                <span
                  class="axis-span"
                  data-mark={event.id}
                  style={`left:${occurred.from}%;width:${occurred.to - occurred.from}%`}
                />
              )}
              <span
                class="axis-dot"
                data-mark={event.id}
                style={`left:${position}%;--level:${level}`}
              />
            </>
          ))
        }
        <span class="axis-review" style={`left:${review}%`}>
          <span>Sources checked</span>
        </span>
      </div>
      <div class="axis-scale">
        {
          months.map((m) => {
            const occurrence = marks.find(
              ({ event }) => event.occurredOn === m.ym,
            );
            return (
              <span
                class:list={[
                  "axis-month",
                  { "axis-month--occurred": occurrence },
                ]}
                style={`left:${m.left}%`}
                data-mark={occurrence?.event.id}
              >
                {m.label}
                {occurrence && <small>{occurrence.occurred.label}</small>}
              </span>
            );
          })
        }
        <span class="axis-month axis-september" style={`left:${RESUME}%`}
          >September</span
        >
        {
          days.map((d) => (
            <span
              class:list={["axis-day", { "axis-day--near": d.near }]}
              style={`left:${d.left}%`}
            >
              {d.label}
            </span>
          ))
        }
        <span class="axis-day axis-day--review" style={`left:${review}%`}
          >{Number(timelineReview.slice(8))}</span
        >
      </div>
      <figcaption class="axis-legend">
        <span><i class="key-dot"></i>Published or announced</span>
        <span><i class="key-span"></i>When it happened, known to the month</span
        >
        <span><i class="key-arc"></i>The time between</span>
        <span>The scale widens at September.</span>
      </figcaption>
    </figure>
    <ol class="timeline-events">
      {
        events.map((event) => (
          <li id={`timeline-${event.id}`} class="timeline-event">
            <article aria-labelledby={`timeline-title-${event.id}`}>
              <p class="timeline-date">
                <time datetime={event.date}>{date(event.date)}</time>
                <span>{event.dateKind}</span>
              </p>
              <h3 id={`timeline-title-${event.id}`}>{event.title}</h3>
              <p>{event.summary}</p>
              <p class="timeline-limit">{event.limit}</p>
              <a class="timeline-source" href={event.source.url}>
                {event.source.publisher}: {event.source.title}
              </a>
            </article>
            <div class="timeline-obligations">
              {event.obligations.map((number) => (
                <div>
                  <h4>
                    <a href={`#obligation-${number}`}>
                      {obligationSummaries[number].title}
                    </a>
                  </h4>
                  <p>{obligationSummaries[number].explanation}</p>
                </div>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="timeline-end">
    <a href="#introduction">Continue to the argument</a>
  </p>
  <Fragment set:html={highlightStyle} />
</section>
<style>
  .timeline {
    max-width: 1440px;
    margin: 0 auto;
    padding: 110px 6% 80px;
    scroll-margin-top: 80px;
  }
  .timeline-heading {
    max-width: 62ch;
    padding-bottom: 64px;
  }
  .timeline-heading h2 {
    font-size: clamp(52px, 6.5vw, 94px);
    margin-bottom: 30px;
  }
  .timeline-meta {
    color: var(--muted);
    font-size: 14px;
  }
  .timeline-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 26px;
    margin-top: 20px;
  }
  .timeline-actions a,
  .timeline-actions button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
  }
  .timeline-actions button[hidden] {
    display: none;
  }
  .timeline-actions button {
    background: none;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 8px 0;
  }

  /* The axis: a drawn overview. Every fact on it is also in the entries. */
  .timeline-axis {
    margin: 0 0 72px;
    --mark: 0;
  }
  .axis-plot {
    position: relative;
    height: 180px;
  }
  .axis-plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .axis-plot path {
    vector-effect: non-scaling-stroke;
  }
  .axis-line {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .axis-future {
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }
  .axis-break {
    stroke: var(--muted);
    stroke-width: 1;
  }
  .axis-arc {
    stroke: var(--accent);
    stroke-width: 1.2;
  }
  .axis-dot,
  .axis-span {
    position: absolute;
    top: 132px;
  }
  /* A paper ring keeps stacked dots distinct where they touch the line. */
  .axis-dot {
    width: 17px;
    height: 17px;
    margin: -8.5px 0 0 -8.5px;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--ink);
    translate: 0 calc(var(--level) * 17px);
  }
  .axis-span {
    height: 5px;
    margin-top: -2.5px;
    background: var(--accent);
  }
  .axis-review {
    position: absolute;
    top: 118px;
    height: 28px;
    border-left: 1px solid var(--ink);
  }
  .axis-review span {
    position: absolute;
    bottom: calc(100% + 6px);
    right: -1px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .axis-scale {
    position: relative;
    height: 58px;
    font-size: 12px;
    color: var(--muted);
  }
  .axis-scale > span {
    position: absolute;
    top: 6px;
    white-space: nowrap;
  }
  .axis-scale > .axis-day {
    translate: -50% 0;
    color: var(--ink);
  }
  .axis-scale > .axis-day--review {
    translate: -100% 0;
    padding-right: 4px;
  }
  .axis-scale > .axis-september {
    top: 28px;
    color: var(--ink);
  }
  .axis-month small {
    display: block;
    font-size: 12px;
    color: var(--accent);
  }
  .axis-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 30px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }
  .axis-legend span {
    display: inline-grid;
    grid-template-columns: 20px auto;
    align-items: center;
    gap: 8px;
  }
  .axis-legend span:last-child {
    display: inline;
  }
  .axis-legend span:last-child {
    margin-left: auto;
  }
  .axis-legend i {
    justify-self: center;
  }
  .key-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
  }
  .key-span {
    width: 18px;
    height: 5px;
    background: var(--accent);
  }
  .key-arc {
    width: 20px;
    height: 10px;
    border: 1.2px solid var(--accent);
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
  }

  /* Hovering or focusing an entry finds its marks; everything else recedes. */
  [data-mark] {
    transition:
      opacity 200ms var(--ease-out),
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      stroke 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .timeline-record:has(.timeline-event:is(:hover, :focus-within))
      :is(.axis-dot, .axis-span, .axis-arc, .axis-month--occurred) {
      opacity: calc(0.28 + var(--mark) * 0.72);
    }
    .timeline-record:has(.timeline-event:is(:hover, :focus-within))
      .axis-dot[data-mark] {
      background: color-mix(
        in srgb,
        var(--accent) calc(var(--mark) * 100%),
        var(--ink)
      );
    }
  }

  /* A left-to-right wipe: the line draws first, then the arcs travel from
     occurrence to disclosure. Dash offsets are unreliable on stretched strokes. */
  .timeline-motion .axis-layer--line {
    clip-path: inset(
      0 calc((1 - clamp(0, var(--timeline-progress, 0) * 2, 1)) * 100%) 0 0
    );
  }
  .timeline-motion .axis-layer--arcs {
    clip-path: inset(
      0
        calc(
          (1 - clamp(0, (var(--timeline-progress, 0) - 0.35) * 1.8, 1)) * 100%
        )
        0 0
    );
  }

  .timeline-events {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 72px 48px;
  }
  .timeline-event {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 26px;
    border-top: 1px solid var(--ink);
    scroll-margin-top: 80px;
  }
  .timeline-date {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 18px;
  }
  .timeline-date time {
    color: var(--ink);
    font-weight: 600;
  }
  .timeline-event h3 {
    font-size: clamp(28px, 2.4vw, 36px);
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .timeline-event article > p {
    font-size: 16px;
    line-height: 1.65;
  }
  .timeline-event .timeline-date {
    font-size: 13px;
  }
  .timeline-event .timeline-limit {
    color: var(--muted);
    font-size: 15px;
  }
  .timeline-source {
    display: inline-block;
    margin-top: 14px;
    padding: 8px 0;
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .timeline-obligations {
    padding-left: 18px;
    border-left: 1px solid var(--accent);
  }
  .timeline-obligations > div + div {
    margin-top: 22px;
  }
  .timeline-obligations h4 {
    font-size: 24px;
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .timeline-obligations p {
    font-size: 15px;
    color: var(--muted);
  }
  .timeline-end {
    margin-top: 72px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
  }

  @media (max-width: 1000px) {
    .timeline {
      padding-top: 72px;
    }
    .timeline-events {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 64px 40px;
    }
    .axis-month--occurred small {
      max-width: 11ch;
      white-space: normal;
    }
    .axis-legend span:last-child {
      margin-left: 0;
    }
  }
  @media (max-width: 700px) {
    .timeline-heading {
      padding-bottom: 44px;
    }
    .timeline-axis {
      margin-bottom: 52px;
    }
    .axis-dot {
      width: 13px;
      height: 13px;
      margin: -6.5px 0 0 -6.5px;
      border-width: 2px;
      translate: 0 calc(var(--level) * 12px);
    }
    .axis-month:nth-child(even),
    .axis-month--occurred small,
    .axis-day--near {
      display: none;
    }
    .axis-legend {
      flex-direction: column;
      gap: 8px;
    }
    .timeline-events {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
  @media (prefers-reduced-motion: reduce), (max-height: 699px) {
    .timeline-motion .axis-layer {
      clip-path: none;
    }
  }
</style>
